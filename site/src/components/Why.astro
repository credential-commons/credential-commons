---
import Base from "../layouts/Base.astro";
import Figure from "./Figure.astro";
import { locales, localeName, type Locale } from "../i18n/ui";
import { why } from "../i18n/why";
import { standards } from "../i18n/standards";
const { lang } = Astro.props as { lang: Locale };
const w = why[lang];
// A diagram per section, by position. Every locale has the same three sections in
// the same order (the nursery and the transplant → the fruit and the label → one
// shared language), so the mapping holds across languages.
const sectionFigures: (string | null)[] = ["what-travels", "growth-rings", "neutral-slots"];
const pathFor = (l: Locale) => (l === "en" ? "/why" : `/${l}/why`);
const homeFor = (l: Locale) => (l === "en" ? "/" : `/${l}/`);
---
<Base lang={lang} title={w.metaTitle} description={w.metaDescription} path="why" ogDiagram="two-trees" pageEntity={{ type: "Article", headline: w.heading }}>
  <main class="wrap">
    <nav class="langs" aria-label="Languages">
      {locales.map((l) => (l === lang ? <strong>{localeName[l]}</strong> : <a href={pathFor(l)}>{localeName[l]}</a>))}
    </nav>

    <h1>{w.heading}</h1>
    <p class="lede">{w.lede}</p>

    {/* This page's own share card, so what a reader sees here is what they share. */}
    <Figure lang={lang} id="two-trees" priority={true} />

    {w.sections.map((s, i) => (
      <section class="why-sec">
        <h2>{s.h}</h2>
        <p>{s.p}</p>
        {sectionFigures[i] && <Figure lang={lang} id={sectionFigures[i]!} />}
      </section>
    ))}

    <h2 class="readers-h">{w.readersHeading}</h2>
    <div class="readers">
      {w.readers.map((r) => (
        <div class="reader"><h3>{r.who}</h3><p>{r.p}</p></div>
      ))}
    </div>

    <h2 class="readers-h">{w.start.heading}</h2>
    <div class="readers">
      {w.start.steps.map((s) => (
        <div class="reader"><h3>{s.who}</h3><p>{s.how}</p></div>
      ))}
    </div>

    <p class="close">{w.close}</p>

    <footer>
      <a href={homeFor(lang)}>{w.backHome}</a> ·
      <a href={lang === "en" ? "/standards" : `/${lang}/standards`}>{standards[lang].navLabel} →</a>
    </footer>
  </main>
</Base>

<style>
  .why-sec { margin: 22px 0; }
  .why-sec h2 { font-size: 1.15rem; margin: 0 0 6px; }
  .why-sec p { margin: 0; }
  .readers-h { font-size: 1.15rem; margin: 30px 0 12px; }
  .readers { display: grid; gap: 12px; }
  .reader { border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
  .reader h3 { margin: 0 0 4px; font-size: 1rem; color: var(--teal); }
  .reader p { margin: 0; color: var(--muted); font-size: .95rem; }
  .close { margin: 26px 0 0; font-size: 1.1rem; }
</style>
