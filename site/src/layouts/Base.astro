---
import { buildDiagrams } from "../data/diagrams";
import { locales, type Locale } from "../i18n/ui";
import Analytics from "../components/Analytics.astro";
const { lang, title, description, path = "", ogDiagram = "credential-commons", pageEntity } = Astro.props as {
  lang: Locale;
  title: string;
  description: string;
  path?: string;
  /** Concept diagram used as this page's share card — an id from src/data/diagrams.ts. */
  ogDiagram?: string;
  /** Page-level schema.org entity. Omit on the homepage, which is the software itself. */
  pageEntity?: { type: "Article" | "WebPage"; headline: string };
};
const SITE = "https://credentialcommons.org";
const pathFor = (l: Locale) => (l === "en" ? `${SITE}/${path}` : `${SITE}/${l}/${path}`);
const canonical = pathFor(lang);
// Built at build time from the diagram's own SVG (scripts/rasterize-diagrams.mjs).
// Absolute URL: several networks refuse to resolve a relative og:image.
// The card is drawn in the page's own language, so a shared Estonian link shows
// an Estonian picture.
const ogImage = lang === "en" ? `${SITE}/diagrams/${ogDiagram}.og.png` : `${SITE}/${lang}/diagrams/${ogDiagram}.og.png`;
const diagramBase = lang === "en" ? `${SITE}/diagrams/${ogDiagram}` : `${SITE}/${lang}/diagrams/${ogDiagram}`;
const figure = buildDiagrams(lang).find((d) => d.id === ogDiagram);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    // The diagram is described, not just linked: image search indexes raster
    // reliably and SVG poorly, and the caption/alt is the explanation itself.
    ...(figure
      ? [
          {
            "@type": "ImageObject",
            "@id": `${canonical}#figure`,
            url: `${diagramBase}.png`,
            contentUrl: `${diagramBase}.png`,
            encodingFormat: "image/png",
            width: 1920,
            height: 1008,
            caption: figure.caption,
            description: figure.alt,
            inLanguage: lang,
            license: "https://creativecommons.org/licenses/by/4.0/",
            acquireLicensePage: `${SITE}/`,
            creditText: "Credential Commons",
          },
        ]
      : []),
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE}/#software`,
      ...(figure ? { image: { "@id": `${canonical}#figure` } } : {}),
      name: "Credential Commons",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Node.js",
      url: `${SITE}/`,
      codeRepository: "https://github.com/credential-commons/credential-commons",
      description,
      inLanguage: lang,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
      keywords: ["credential", "micro-credential", "learning outcome", "Linked Data", "JSON-LD", "SHACL", "CTDL", "ELM", "Open Badges", "interoperability"],
    },
    { "@type": "DefinedTermSet", "@id": `${SITE}/ns/0.1/`, name: "Credential Commons vocabulary (cc:)", url: `${SITE}/ns/0.1/` },
    {
      "@type": "Dataset",
      "@id": `${SITE}/#reference-dataset`,
      name: "mkval micro-qualification reference dataset",
      description: "250 real Estonian micro-qualifications published as Credential Commons-conformant JSON-LD.",
      license: "https://creativecommons.org/licenses/by/4.0/",
      isAccessibleForFree: true,
    },
    // The site-level graph above says what the project is; without this the
    // subpages carried no entity of their own, so /why and /standards looked
    // to a crawler like two more copies of the homepage's software listing.
    ...(pageEntity
      ? [
          {
            "@type": pageEntity.type,
            "@id": `${canonical}#page`,
            headline: pageEntity.headline,
            description,
            inLanguage: lang,
            isPartOf: { "@id": `${SITE}/#software` },
            mainEntityOfPage: canonical,
            ...(figure ? { image: { "@id": `${canonical}#figure` } } : {}),
            author: { "@type": "Organization", name: "Credential Commons", url: `${SITE}/` },
            license: "https://creativecommons.org/licenses/by/4.0/",
          },
        ]
      : []),
  ],
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {locales.map((l) => <link rel="alternate" hreflang={l} href={pathFor(l)} />)}
  <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Credential Commons" />
  <meta property="og:locale" content={lang} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={description} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={description} />
  <meta name="robots" content="index,follow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  {/* Privacy-first, cookieless analytics (Umami). Renders only when configured;
      no consent banner needed, no Google. See src/components/Analytics.astro
      for what this does and does not measure, and docs/analytics-proposal.md
      for the reasoning behind the one custom event it sends. */}
  <Analytics />
  <style is:global>
    :root { --ink:#12212e; --teal:#2f9e95; --muted:#5a6b80; --line:#dbe4ee; }
    * { box-sizing: border-box; }
    body { margin:0; font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif; color:var(--ink); }
    .wrap { max-width:760px; margin:0 auto; padding:40px 20px; }
    h1 { font-size:2rem; margin:0 0 8px; }
    .lede { font-size:1.15rem; color:var(--muted); margin:0 0 26px; }
    pre { background:#0f1b24; color:#e6edf3; padding:14px 16px; border-radius:10px; overflow-x:auto; font-size:.9rem; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; }
    a { color:var(--teal); font-weight:600; text-decoration:none; }
    a:hover { text-decoration:underline; }
    .grid { display:grid; gap:12px; grid-template-columns:1fr 1fr; margin:22px 0; }
    .card { border:1px solid var(--line); border-radius:12px; padding:14px 16px; }
    .card h3 { margin:0 0 4px; font-size:1rem; }
    .card p { margin:0; color:var(--muted); font-size:.92rem; }
    nav.langs { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:22px; font-size:.9rem; }
    footer { margin-top:34px; padding-top:16px; border-top:1px solid var(--line); color:var(--muted); font-size:.88rem; }
    .tag { display:inline-block; background:#eaf6f4; color:#1f6f68; border-radius:999px; padding:2px 10px; font-size:.8rem; font-weight:700; }
  </style>
</head>
<body>
  <slot />
</body>
</html>
