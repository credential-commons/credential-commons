{
  "@context": {
    "@version": 1.1,
    "cc": "https://credentialcommons.org/ns/0.1/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "haridus": "https://schema.edu.ee/0.1/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "MicroCredential": "cc:MicroCredential",
    "Curriculum": "cc:Curriculum",
    "Course": "cc:Course",
    "Program": "cc:Program",
    "Session": "cc:Session",
    "Achievement": "cc:Achievement",
    "CompetencyAlignment": "cc:CompetencyAlignment",
    "LearningOutcome": "cc:LearningOutcome",
    "LearningResource": "cc:LearningResource",
    "Cohort": "cc:Cohort",
    "Assessment": "cc:Assessment",
    "Organization": "schema:Organization",
    "Person": "schema:Person",

    "name": "schema:name",
    "url": { "@id": "schema:url", "@type": "@id" },
    "summary": "schema:description",
    "field": "cc:field",
    "language": "dcterms:language",

    "provider": "schema:provider",
    "instructor": "schema:instructor",

    "ectsCredits": { "@id": "cc:ectsCredits", "@type": "xsd:decimal" },
    "academicHours": { "@id": "cc:academicHours", "@type": "xsd:decimal" },
    "clockHours": { "@id": "cc:clockHours", "@type": "xsd:decimal" },
    "learningOutcome": "cc:learningOutcome",
    "crossCutting": { "@id": "cc:crossCutting", "@type": "xsd:boolean" },
    "broader": { "@id": "skos:broader", "@type": "@id" },
    "entryRequirements": "cc:entryRequirements",
    "content": "cc:content",
    "awardedCredential": "cc:awardedCredential",
    "level": "cc:level",
    "deliveryMode": "cc:deliveryMode",

    "hasPart": { "@id": "schema:hasPart", "@type": "@id" },
    "partOf": { "@id": "schema:isPartOf", "@type": "@id" },
    "standalone": { "@id": "cc:standalone", "@type": "xsd:boolean" },

    "schedule": "cc:schedule",
    "endDate": { "@id": "schema:endDate", "@type": "xsd:date" },

    "delivers": { "@id": "cc:delivers", "@type": "@id" },
    "capacity": "schema:maximumAttendeeCapacity",
    "location": "schema:location",

    "awards": { "@id": "cc:awards", "@type": "@id" },
    "cohort": { "@id": "cc:cohort", "@type": "@id" },
    "awardedTo": "cc:awardedTo",
    "awardedDate": { "@id": "cc:awardedDate", "@type": "xsd:date" },
    "issuer": "schema:issuer",
    "evidence": { "@id": "cc:evidence", "@type": "@id" },

    "teaches": "schema:teaches",
    "learningResourceType": "schema:learningResourceType",

    "aligns": "cc:aligns",
    "targetFramework": "cc:targetFramework",
    "targetCode": "cc:targetCode",
    "targetName": "cc:targetName",
    "targetUrl": { "@id": "cc:targetUrl", "@type": "@id" },

    "price": "cc:price",
    "priceCurrency": "cc:priceCurrency",
    "registrationDeadline": { "@id": "cc:registrationDeadline", "@type": "xsd:date" },
    "startDate": { "@id": "schema:startDate", "@type": "xsd:date" },

    "criteria": "cc:criteria",
    "assesses": { "@id": "cc:assesses", "@type": "@id" }
  }
}
