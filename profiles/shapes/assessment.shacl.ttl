# Credential Commons — Assessment profile (v0.2)
#
# An assessment (Estonian: hindamine) — how a learning outcome is checked.
# HAKA (Estonian quality agency) requires that every learning outcome carry a
# clear assessment METHOD and CRITERIA. CC models the assessment DESIGN — the
# method (schema:name, e.g. "Praktiline töö") and criteria (cc:criteria) for
# an objective, transparent judgement, plus which outcome(s) it assesses
# (cc:assesses). This is what TRAVELS with the curriculum (HAKA 6.5).
#
# OUT OF SCOPE: test instances and learner results (who sat it, what score they
# got) are PII — nursery-internal, never modelled here.
#
# STRUCTURE only. Severity: sh:Violation = MUST fix; sh:Warning = SHOULD add.

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix cc:      <https://credentialcommons.org/ns/0.1/> .
@prefix schema:  <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

cc:AssessmentShape
    a sh:NodeShape ;
    sh:targetClass cc:Assessment ;
    rdfs:label "Assessment profile" ;

    # --- Required (Violation) ---
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:datatype xsd:string ; sh:severity sh:Violation ;
        sh:message "An assessment MUST name its method (schema:name), e.g. Praktiline töö / Test / Portfoolio." ] ;
    sh:property [ sh:path cc:criteria ; sh:minCount 1 ; sh:severity sh:Violation ;
        sh:message "An assessment MUST state its criteria (cc:criteria) — what an objective, transparent judgement checks." ] ;
    sh:property [ sh:path cc:assesses ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:severity sh:Violation ;
        sh:message "An assessment MUST reference the learning outcome(s) it assesses (cc:assesses -> a LearningOutcome by @id). HAKA: every outcome must be assessable." ] .
